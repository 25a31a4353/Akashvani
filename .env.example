# Akashvani — Disaster Intelligence Platform
# Environment Configuration Example

# Server Configuration
PORT=3000
NODE_ENV=development

# Application Title
VITE_APP_TITLE="Akashvani — Disaster Intelligence Platform"

# Authentication & Security
JWT_SECRET=development-secret-key-change-in-production
OWNER_OPEN_ID=
VITE_APP_ID=
OAUTH_SERVER_URL=https://oauth.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im

# Database Configuration (MySQL / TiDB)
# If left unset, Akashvani runs with an in-memory development store
# DATABASE_URL=mysql://root:password@localhost:3306/akashvani

# Storage Configuration (Manus Forge or S3)
# If left unset, local filesystem storage in ./uploads is used automatically
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# LLM / AI Configuration
# Optional: OpenAI-compatible API key for LLM integration
OPENAI_API_KEY=

# Map Configuration (Optional: Custom tile layer)
# Default: ESRI World Imagery
VITE_MAP_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Analytics (Optional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
